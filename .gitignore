# ============================================================
#  Dopamine-PINN — .gitignore for the public GitHub repo
# ============================================================

# ----- macOS / OS metadata -----
.DS_Store
Thumbs.db

# ----- Python build / cache -----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# ----- Jupyter -----
.ipynb_checkpoints/
*.nbconvert.ipynb

# ----- LaTeX build artifacts -----
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.bbl
*.blg
*.bcf
*.run.xml
*.tex.bak

# ----- Generated zip archives -----
*.zip

# ----- Personal / private files (must NOT be committed) -----
cover_letter.md
cover_letter.pdf
*_CV_*.pdf
Reference Papers/

# ----- Manuscript source (kept off the public repo) -----
B3_Dopamine_PINN_Paper.tex
B3_Dopamine_PINN_Paper.pdf

# ----- Supporting Information (part of the unpublished manuscript) -----
S1_Text.tex
S1_Text.pdf
S2_Text.tex
S2_Text.pdf

# ----- Submission bundle (private, contains manuscript) -----
PLOS_Submission_*/

# ----- Stray temp files -----
figures/metrics_forward_backup.json

# ----- Intermediate experiment artifacts (kept locally, not shipped) -----
dopamine_PINN_artifacts/
dopamine_PINN_2D_artifacts*/
dopamine_PINN_2D_artifacts*.zip

# ----- Sibling-project working trees (have their own repos) -----
# The B4 FDA Nozzle/Pump PINN paper lives at:
#   https://github.com/Hachero98/fda-nozzle-pump-pinn
# Files exist on disk for convenience but are not tracked by this repo.
B4_FDA_Nozzle_PINN_Paper/

# ----- Editor / IDE -----
.vscode/
.idea/
*.swp
*.swo
